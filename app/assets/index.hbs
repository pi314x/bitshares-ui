<!doctype html>
<html>

<head>
    {{#if INCLUDE_BASE}}
    <base href="/">
    {{/if}}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width" />
    <meta name="format-detection" content="telephone=no">
    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    <meta name="application-name" content="{{title}}">
    <meta name="apple-mobile-web-app-title" content="{{title}}">
    <meta name="color-scheme" content="dark light">
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{title}}">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' blob:; worker-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: https: ws://127.0.0.1:* ws://localhost:*; font-src 'self' data:; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self';">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <script>
        // Before first paint: apply the saved theme to <html>, so the splash, the
        // loading screen and the app agree and nothing flashes between them.
        (function () {
            try {
                var saved = JSON.parse(localStorage.getItem("__graphene__settings_v4") || "{}");
                document.documentElement.setAttribute("data-theme", saved && saved.themes === "lightTheme" ? "light" : "dark");
            } catch (e) { }
        })();
    </script>
    <style>
        /* First paint, before any script or stylesheet of the app has loaded.
           Values mirror app/design-system/_palette.scss (dark and light). */
        :root {
            --boot-bg: #0b0f14;
            --boot-ink: #e9eef5;
            --boot-muted: #8794a7;
            --boot-accent: #16b8f3;
                    }

        /* The app's own theme setting decides (set by the script below), not the
           system scheme: the app starts dark unless the user chose light, and a
           splash in the other scheme would flash before the app paints. */
        :root[data-theme="light"] {
            --boot-bg: #ffffff;
            --boot-ink: #111827;
            --boot-muted: #646e82;
            --boot-accent: #0074a6;
                    }

        html {
            background-color: var(--boot-bg);
        }

        body {
            margin: 0;
            background-color: var(--boot-bg);
        }

        .centerDiv {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            /* The loading screen centres its whole group (ring, title, the steps and
               the two lines for the status and the chosen node, all of fixed
               height) in the window; the ring here stands where that group's ring
               will, so nothing moves when the screen takes over: the spacer below is
               the height of what comes under the ring there (18 + 24 + 18 + 200 +
               18 + 18 + 18 + 18, see LoadingScreen.module.scss). */
            justify-content: center;
            margin: 0;
            color: var(--boot-ink);
            font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
            font-size: 17px;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .centerDiv::after {
            content: "";
            flex: none;
            height: 332px;
        }

        /* Same ring, with the BitShares mark in it, as components/LoadingIndicator
           (LogoRing) and the loading screen: a 56px box, a track and an arc with a
           fading tail and a round head that turns by transform only (smooth while
           the page is busy), a 12.5% band at 87.5% of the box; the mark stands
           still. The mark is the data URL of assets/logo-ico-blue.png (img-src
           allows data:). */
        .centerDiv .boot-logo-ring {
            --ring-t: 7px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            color: var(--boot-accent);
        }

        .centerDiv .boot-track,
        .centerDiv .boot-spin {
            position: absolute;
            inset: 6.25%;
            border-radius: 50%;
            -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - var(--ring-t)), #000 calc(100% - var(--ring-t)));
            mask: radial-gradient(farthest-side, transparent calc(100% - var(--ring-t)), #000 calc(100% - var(--ring-t)));
        }

        .centerDiv .boot-track {
            background: currentColor;
            opacity: 0.18;
        }

        .centerDiv .boot-spin {
            background: conic-gradient(from 0deg, transparent 50deg, currentColor 360deg);
            animation: boot-spin 1.2s linear infinite;
            will-change: transform;
        }

        .centerDiv .boot-spin::after {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: var(--ring-t);
            height: var(--ring-t);
            margin-left: calc(var(--ring-t) / -2);
            border-radius: 50%;
            background: currentColor;
        }

        .centerDiv .boot-logo {
            position: relative;
            height: 44%;
            width: auto;
        }

        @keyframes boot-spin {
            to {
                transform: rotate(360deg);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .centerDiv .boot-spin {
                animation-duration: 3s;
            }
        }
    </style>
    {{#if ELECTRON}}
    <script>
        var ref = encodeURIComponent(document.referrer);
        if (window.process && window.process.versions && window.process.versions['electron']) {
            window.electron = window.process.versions['electron'];
            window.remote = require('electron').remote;
            window._$guid$_ = window.remote.getGlobal('guid');
            window.app_version = window.remote.getGlobal('version');
            ref = 'lw-' + window.process.platform + '-' + window.app_version + '-' + window.remote.getGlobal('guid');
            window.onload = function (e) {
                var content = document.getElementById("content");
                if (content) content.className = "electron " + window.process.platform;
            }
        }
    </script>
    {{/if}}
</head>

<body spellcheck="false">
    <main id="content">
        <div class="centerDiv" role="status"><span class="boot-logo-ring"><span class="boot-track" aria-hidden="true"></span><span class="boot-spin" aria-hidden="true"></span><img class="boot-logo" alt="" src="data:image/png;base64,"></span></div>
    </main>
    <script>
        // Where the splash's ring began its turn (the document's timeline): the loading screen's
        // ring takes up the same turn (components/LoadingIndicator, LogoRing), so the hand-over
        // is not a jump back to the top.
        (function () {
            try {
                var ring = document.querySelector(".boot-spin");
                var turn = ring && ring.getAnimations ? ring.getAnimations()[0] : null;
                if (turn) turn.ready.then(function () { window.__ringStart = turn.startTime; });
            } catch (e) { }
        })();
    </script>
    <script>
        function ieVersion(uaString) {
            uaString = uaString || navigator.userAgent;
            var match = /\b(MSIE |Trident.*?rv:|Edge\/)(\d+)/.exec(uaString);
            if (match) return parseInt(match[2])
        }
        function createLinkTag() {
            var link = document.createElement("link");
            link.href = "outdated_browser.css";
            link.type = "text/css";
            link.rel = "stylesheet";
            document.getElementsByTagName("head")[0].appendChild(link);
        }
        function renderOutdatedWarning() {
            createLinkTag();
            var container = document.createElement("div");
            var header = document.createElement("div");
            var body = document.createElement("div");
            var footer = document.createElement("div");
            var linkWrapper = document.createElement("div");
            var link = document.createElement("a");
            var closeLink = document.createElement("span");
            var btn = document.createElement("button");

            var headerText = document.createTextNode("Unsupported browser");
            var bodyText = document.createTextNode("The Browser you are using has not been fully tested to support the BitShares Wallet. We highly recommend that you backup your local wallet and import it using the Chrome Browser.");
            var linkText = document.createTextNode("Google Chrome");
            var closeLinkText = document.createTextNode("×");
            var btnText = document.createTextNode("I UNDERSTAND");

            linkWrapper.classList.add("outdated-browser__link-wrapper");
            link.appendChild(linkText);
            link.setAttribute("href", "https://www.google.com/chrome/browser/desktop/");
            link.setAttribute("target", "_blank");
            linkWrapper.appendChild(link);

            closeLink.classList.add("outdated-browser__close");
            closeLink.appendChild(closeLinkText);


            container.classList.add("outdated-browser");
            header.appendChild(headerText);
            header.appendChild(closeLink);
            header.classList.add("outdated-browser__header");

            body.appendChild(bodyText);
            body.classList.add("outdated-browser__body");
            body.appendChild(linkWrapper);


            btn.classList.add("outdated-browser__btn");
            btn.appendChild(btnText);

            footer.classList.add("outdated-browser__footer");
            footer.appendChild(btn);


            container.appendChild(header);
            container.appendChild(body);
            container.appendChild(footer);

            document.getElementById("content").appendChild(container);
        }

        if (ieVersion()) {
            renderOutdatedWarning();
            document.getElementById("content").removeChild(document.querySelector(".centerDiv"));

            var closeBtn = document.querySelector(".outdated-browser__close");
            var okBtn = document.querySelector(".outdated-browser__btn");
            var container = document.querySelector(".outdated-browser");
            closeBtn.addEventListener("click", function () {
                container.classList.add("hidden");
            });

            okBtn.addEventListener("click", function () {
                container.classList.add("hidden");
            });
        }
    </script>
</body>

</html>