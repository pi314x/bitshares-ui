# Settings read from the environment, or from a file called .env in this folder (copy this
# file to .env and edit it; .env is never committed). A value in the real environment wins
# over the file. Everything here is OFF or the safest choice unless you change it.
#
# Read by: the MCP server (`node mcp/server.js`) when it starts, and the web build
# (`yarn build`, `yarn start`), which decides there whether the MCP page is part of the app.
# See docs/MCP.md.

# --- MCP server ---------------------------------------------------------------------------

# Master switch. false: the server does not start and the app has no MCP page.
MCP_ENABLED=false

# How an AI client reaches the server:
#   stdio  the client starts `node mcp/server.js` itself; nothing listens on a port (safest)
#   http   one local web address; needs MCP_AUTH_TOKEN
MCP_TRANSPORT=stdio

# Only for http. The server listens on this machine only unless you change the host.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
# At least 24 random characters: `node mcp/server.js --new-token`. Never commit a real one.
MCP_AUTH_TOKEN=
# Web origins that may call the http transport from a browser. Leave empty (none).
MCP_ALLOWED_ORIGINS=

# Nodes the server asks, comma separated, https (http only for localhost). The first that
# answers is used.
MCP_NODES=https://node.xbts.io/ws

# Where BitShares Desk is served, for the links the trading tools make.
MCP_APP_URL=http://localhost:8080
# true if the app is built with hash routing (yarn build-hash)
MCP_APP_HASH_ROUTER=false

# --- Trading: preparing orders for a person to sign ---------------------------------------
# The server never holds a key and cannot sign. These tools only PREPARE an order: they make
# a link that the person opens in BitShares Desk, where the application shows the order and
# the person signs it with their own wallet, or not.

MCP_TRADING_ENABLED=false

# The accounts an order may be prepared for (required when trading is on).
MCP_TRADING_ACCOUNTS=

# The assets that may be traded at all, and for each the most one order and, after the colon,
# the most 24 hours may sell: SYMBOL:PER_ORDER[:PER_DAY]. Required when trading is on.
# Example: BTS:1000:5000,XBTSX.USDT:100:500
MCP_TRADE_LIMITS=

# Refuse a price that pays more than this many percent above the market's.
MCP_MAX_PRICE_DEVIATION_PERCENT=3
# How long a prepared order can be opened for signing, in minutes.
MCP_PROPOSAL_TTL_MINUTES=10
# The longest an order may stay open once it is placed, in hours.
MCP_MAX_ORDER_EXPIRATION_HOURS=48
# How many orders may be prepared per hour.
MCP_PREPARE_PER_HOUR=20
# Where the server keeps what it prepared lately, so that the limits per hour and per day
# hold across restarts (a client that starts the server anew for every session would
# otherwise begin each time with an empty page). A file in this folder; never commit it.
MCP_STATE_FILE=.mcp-state.json
# Allow an order in a market that has no price to compare with (not recommended).
MCP_ALLOW_UNPRICED_MARKETS=false
